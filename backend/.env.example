# ============================================================================
# Core
# ============================================================================
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated allowlist of browser origins (see app.ts / CORS).
# Leave empty in production to deny browser access; set when serving a UI.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# When true, missing/invalid Bearer tokens fall back to a shared dev user.
# Default: true in non-prod, false in prod. Do NOT enable in production.
# ALLOW_DEV_AUTH_FALLBACK=true

# ============================================================================
# Supabase — verify Auth access tokens (HS256 with project JWT secret)
# ============================================================================
SUPABASE_JWT_SECRET=

# ============================================================================
# Database (Postgres / Supabase)
# ============================================================================
DATABASE_URL=

# ============================================================================
# Redis (rate limiting) — Upstash REST API
# ============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================================
# LLM providers (required for assistant replies — chat + voice)
# At least ONE of OPENAI_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY, or GROQ_API_KEY
# must be set to generate text. Without these, every voice turn will fail with
# "Incorrect API key provided" (HTTP 401 from the LLM provider).
# ============================================================================
OPENAI_API_KEY=
# Optional alternative — used when the assistant is configured with a
# google/gemini model instead of OpenAI.
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq (OpenAI-compatible, fast inference) — https://console.groq.com/keys
GROQ_API_KEY=

# ============================================================================
# Voice pipeline — REQUIRED for the realtime voice session
# Without these, voice sessions will appear "stuck in Listening" because
# STT never produces a transcript and TTS never returns audio.
# ============================================================================
# Deepgram (speech-to-text) — https://console.deepgram.com
DEEPGRAM_API_KEY=
# Optional: override Deepgram listen language (defaults to "multi" for
# multilingual, e.g. Hindi/Hinglish/English blends).
# DEEPGRAM_LANGUAGE=multi

# ElevenLabs (text-to-speech) — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ============================================================================
# Tool execution hardening (custom-api + managed integrations)
# ============================================================================
# Max timeout for outbound tool fetches (ms). Defaults to 15000.
# TOOL_FETCH_TIMEOUT_MS=15000

# When true, user-configured tool URLs may target private/loopback IPs
# (localhost, 10.x, 192.168.x, etc). Only enable for local dev.
# Default: true in non-prod, false in prod.
# ALLOW_PRIVATE_TOOL_TARGETS=true

# ============================================================================
# Dev user fallback (used when ALLOW_DEV_AUTH_FALLBACK=true)
# ============================================================================
# DEV_USER_ID=dev-user
# DEV_USER_EMAIL=dev@assistant.local
# DEV_USER_NAME=Developer
